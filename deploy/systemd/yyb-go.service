[Unit]
Description=YYB Go 本地账号服务（应用宝协议）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/yyb-go
ExecStart=/opt/yyb-go/yyb-go
Restart=always
RestartSec=5
Environment=TZ=Asia/Shanghai
# 日志交给 journald：journalctl -u yyb-go -f
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
